# Local tool settings. Copy to .env (gitignored). Never put a real token in this file.
AWS_PROFILE=qmc
AWS_REGION=us-east-2
QMC_ENV=dev
# Function URL, from `make outputs` (api_url). clients/qmc.py reads it.
QMC_API_URL=
# Only for a local Qrypt probe (tools/qrypt_probe); Lambda reads the token from SSM.
QRYPT_API_KEY=
